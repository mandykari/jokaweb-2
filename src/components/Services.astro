---
const services = [
  {
    number: "01",
    name: "Diseño Web",
    description: "Interfaces únicas, claras y alineadas con la personalidad de tu marca.",
    href: "/servicios#diseno-web",
    paths: ["M4 5h16v11H4z", "M8 20h8", "M12 16v4", "M7 9h4", "M7 12h7"],
  },
  {
    number: "02",
    name: "Desarrollo Web",
    description: "Sitios rápidos, sólidos y preparados para crecer junto con tu negocio.",
    href: "/servicios#desarrollo-web",
    paths: ["m8 8-4 4 4 4", "m16 8 4 4-4 4", "m14 4-4 16"],
  },
  {
    number: "03",
    name: "Tiendas Online",
    description: "Experiencias de compra simples y optimizadas para transformar visitas en ventas.",
    href: "/servicios#tiendas-online",
    paths: ["M4 9v11h16V9", "M3 4h18l-2 5H5z", "M9 13h6", "M12 10v6"],
  },
  {
    number: "04",
    name: "Mantenimiento Web",
    description: "Soporte continuo para mantener tu web segura, actualizada y funcionando al máximo.",
    href: "/servicios#mantenimiento-web",
    paths: ["M20 7h-5V2", "M4 17h5v5", "M19 12a7 7 0 0 0-12-5L4 10", "M5 12a7 7 0 0 0 12 5l3-3"],
  },
  {
    number: "05",
    name: "SEO",
    description: "Estrategias para mejorar tu visibilidad y conectar con quienes ya te están buscando.",
    href: "/servicios#seo",
    paths: ["M11 18a7 7 0 1 1 0-14 7 7 0 0 1 0 14Z", "m16 16 5 5", "M8 13v-2", "M11 13V8", "M14 13v-4"],
  },
  {
    number: "06",
    name: "Publicidad Digital",
    description: "Campañas enfocadas en alcance, oportunidades comerciales y resultados medibles.",
    href: "/servicios#publicidad-digital",
    paths: ["M4 13V9l11-4v12L4 13Z", "M15 9a3 3 0 0 1 0 4", "m7 14 1 5h4l-2-6"],
  },
];
---

<section class="services-section" id="servicios" aria-labelledby="services-title">
  <div class="container">
    <header class="section-heading">
      <div>
        <p class="section-eyebrow"><span></span> Soluciones digitales</p>
        <h2 id="services-title">Todo lo que tu negocio necesita para crecer online.</h2>
      </div>
      <p class="section-description">
        Desde el diseño y desarrollo de tu sitio hasta su posicionamiento y promoción, creamos soluciones digitales pensadas para objetivos reales.
      </p>
    </header>

    <div class="services-grid">
      {
        services.map((service) => (
          <article class="service-card">
            <div class="service-card-top">
              <span class="service-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  {service.paths.map((path) => <path d={path} />)}
                </svg>
              </span>
              <span class="service-number" aria-hidden="true">{service.number}</span>
            </div>
            <h3>{service.name}</h3>
            <p>{service.description}</p>
            <a href={service.href}>
              Conocer servicio
              <svg viewBox="0 0 20 20" aria-hidden="true">
                <path d="M4 10h12m-5-5 5 5-5 5" />
              </svg>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .services-section {
    padding-block: var(--space-12) 3.75rem;
    background: var(--color-surface);
  }

  .section-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(19rem, 0.65fr);
    align-items: end;
    gap: clamp(2rem, 7vw, 7rem);
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .section-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: var(--space-4);
    color: var(--color-primary-dark);
    font-size: var(--font-size-xs);
    font-weight: 750;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .section-eyebrow span {
    width: 1.8rem;
    height: 0.125rem;
    border-radius: var(--radius-pill);
    background: var(--color-primary);
  }

  h2 {
    max-width: 17ch;
    font-size: var(--font-size-heading-sm);
    letter-spacing: -0.045em;
  }

  .section-description {
    max-width: 33rem;
    padding-bottom: 0.25rem;
    color: var(--color-text);
    font-size: var(--font-size-lg);
    line-height: 1.75;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
  }

  .service-card {
    position: relative;
    display: flex;
    min-height: 21.5rem;
    flex-direction: column;
    padding: clamp(2rem, 3vw, 2.75rem);
    overflow: hidden;
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
    transition: background-color var(--transition-base), box-shadow var(--transition-base), transform var(--transition-base);
  }

  .service-card::before {
    position: absolute;
    width: 11rem;
    height: 11rem;
    top: -7rem;
    right: -7rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(156 78 255 / 0.15), transparent 70%);
    content: "";
    opacity: 0;
    transition: opacity var(--transition-base), transform var(--transition-base);
  }

  .service-card:hover {
    z-index: 1;
    background: var(--color-primary-faint);
    box-shadow: var(--shadow-md);
    transform: translateY(-0.25rem);
  }

  .service-card:hover::before {
    opacity: 1;
    transform: scale(1.3);
  }

  .service-card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: auto;
  }

  .service-icon {
    display: grid;
    width: 3.25rem;
    height: 3.25rem;
    border: 1px solid rgb(156 78 255 / 0.16);
    border-radius: 1rem;
    background: var(--color-primary-soft);
    color: var(--color-primary-dark);
    place-items: center;
  }

  .service-icon svg {
    width: 1.4rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.6;
  }

  .service-number {
    color: #aaa4b0;
    font-size: var(--font-size-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  h3 {
    margin-top: var(--space-10);
    font-size: clamp(1.45rem, 2vw, 1.7rem);
    letter-spacing: -0.035em;
  }

  .service-card > p {
    max-width: 30ch;
    margin-top: var(--space-3);
    color: var(--color-text);
    font-size: 0.95rem;
    line-height: 1.75;
  }

  .service-card > a {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.55rem;
    margin-top: var(--space-8);
    color: var(--color-ink);
    font-size: 0.9rem;
    font-weight: 700;
    transition: color var(--transition-fast), gap var(--transition-fast);
  }

  .service-card > a svg {
    width: 1rem;
    fill: none;
    stroke: var(--color-primary);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.75;
  }

  .service-card > a:hover {
    gap: 0.8rem;
    color: var(--color-primary-dark);
  }

  @media (max-width: 64rem) {
    .services-section {
      padding-block: 2.5rem var(--space-12);
    }

    .section-heading {
      grid-template-columns: minmax(0, 1fr) minmax(17rem, 0.65fr);
      gap: 3rem;
    }

    .services-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 47.99rem) {
    .section-heading {
      grid-template-columns: 1fr;
      gap: var(--space-5);
      margin-bottom: var(--space-12);
    }

    h2 {
      max-width: 19ch;
    }

    .section-description {
      padding-bottom: 0;
      font-size: 1rem;
    }
  }

  @media (max-width: 37.5rem) {
    .services-section {
      padding-block: 1.75rem var(--space-8);
    }

    .services-grid {
      grid-template-columns: 1fr;
    }

    .service-card {
      min-height: 19rem;
      padding: 1.75rem;
    }
  }
</style>
