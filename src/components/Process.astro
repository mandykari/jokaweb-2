---
const steps = [
  {
    number: "01",
    title: "Descubrimiento",
    description: "Entendemos tu negocio, objetivos, público y necesidades.",
  },
  {
    number: "02",
    title: "Estrategia y diseño",
    description: "Definimos estructura, experiencia y dirección visual.",
  },
  {
    number: "03",
    title: "Desarrollo",
    description: "Convertimos el diseño en una experiencia web rápida y responsive.",
  },
  {
    number: "04",
    title: "Lanzamiento",
    description: "Probamos, optimizamos y dejamos todo preparado para publicar.",
  },
];
---

<section class="process-section" aria-labelledby="process-title">
  <div class="container">
    <header class="process-heading">
      <div>
        <p class="section-eyebrow"><span></span> Proceso</p>
        <h2 id="process-title">De una idea a una web lista para crecer.</h2>
      </div>
      <p>
        Un proceso claro, colaborativo y enfocado en construir una solución digital alineada a tus objetivos.
      </p>
    </header>

    <ol class="process-list">
      {
        steps.map((step) => (
          <li class="process-step">
            <div class="step-marker">
              <span>{step.number}</span>
            </div>
            <div class="step-content">
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process-section {
    padding-block: 3.75rem;
    overflow: hidden;
    background: var(--color-surface);
  }

  .process-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(19rem, 0.65fr);
    align-items: end;
    gap: clamp(2rem, 7vw, 7rem);
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .section-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: var(--space-4);
    color: var(--color-primary-dark);
    font-size: var(--font-size-xs);
    font-weight: 750;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .section-eyebrow span {
    width: 1.8rem;
    height: 0.125rem;
    border-radius: var(--radius-pill);
    background: var(--color-primary);
  }

  h2 {
    max-width: 17ch;
    font-size: var(--font-size-heading-sm);
    letter-spacing: -0.045em;
  }

  .process-heading > p {
    max-width: 32rem;
    color: var(--color-text);
    font-size: var(--font-size-lg);
    line-height: 1.75;
  }

  .process-list {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    list-style: none;
  }

  .process-list::before {
    position: absolute;
    top: 2.1rem;
    right: calc(25% - 2.125rem);
    left: 2.125rem;
    height: 1px;
    background: linear-gradient(90deg, rgb(156 78 255 / 0.18), var(--color-primary), rgb(156 78 255 / 0.18));
    content: "";
  }

  .process-step {
    position: relative;
    min-width: 0;
    padding-inline: clamp(1rem, 2.5vw, 2rem);
  }

  .process-step:first-child {
    padding-left: 0;
  }

  .process-step:last-child {
    padding-right: 0;
  }

  .step-marker {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    margin-bottom: var(--space-8);
  }

  .step-marker span {
    display: grid;
    width: 4.25rem;
    height: 4.25rem;
    border: 1px solid rgb(156 78 255 / 0.2);
    border-radius: 1.35rem;
    background: var(--color-surface);
    box-shadow: 0 0.75rem 2.5rem rgb(69 35 106 / 0.08);
    color: var(--color-primary-dark);
    font-size: var(--font-size-sm);
    font-weight: 800;
    letter-spacing: 0.08em;
    place-items: center;
    transform: rotate(-3deg);
  }

  .process-step:nth-child(even) .step-marker span {
    transform: rotate(3deg);
  }

  h3 {
    font-size: clamp(1.2rem, 1.8vw, 1.45rem);
    letter-spacing: -0.03em;
  }

  .step-content p {
    max-width: 25ch;
    margin-top: var(--space-3);
    color: var(--color-text);
    font-size: 0.92rem;
    line-height: 1.7;
  }

  @media (max-width: 64rem) {
    .process-section {
      padding-block: var(--space-12);
    }

    .process-heading {
      grid-template-columns: minmax(0, 1fr) minmax(17rem, 0.65fr);
      gap: 3rem;
    }

    .process-step {
      padding-inline: 1rem;
    }
  }

  @media (max-width: 47.99rem) {
    .process-heading {
      grid-template-columns: 1fr;
      gap: var(--space-5);
      margin-bottom: var(--space-12);
    }

    .process-heading > p {
      font-size: 1rem;
    }

    .process-list {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .process-list::before {
      top: 2rem;
      bottom: 2rem;
      left: 2rem;
      width: 1px;
      height: auto;
      background: linear-gradient(to bottom, rgb(156 78 255 / 0.18), var(--color-primary), rgb(156 78 255 / 0.18));
    }

    .process-step,
    .process-step:first-child,
    .process-step:last-child {
      display: grid;
      grid-template-columns: 4.1rem 1fr;
      gap: var(--space-5);
      padding: 0 0 var(--space-10);
    }

    .process-step:last-child {
      padding-bottom: 0;
    }

    .step-marker {
      margin: 0;
    }

    .step-marker span {
      width: 4rem;
      height: 4rem;
      border-radius: 1.2rem;
    }

    .step-content {
      padding-top: 0.5rem;
    }

    .step-content p {
      max-width: 36ch;
    }
  }

  @media (max-width: 37.5rem) {
    .process-section {
      padding-block: var(--space-8);
    }
  }
</style>
