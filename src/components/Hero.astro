---
import site from "../data/site.json";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-glow hero-glow--one"></div>
  <div class="hero-glow hero-glow--two"></div>

  <div class="container hero-grid">
    <div class="hero-content">
      <p class="hero-badge">
        <span class="badge-dot"></span>
        Diseño <span aria-hidden="true">·</span> Desarrollo <span aria-hidden="true">·</span> Estrategia digital
      </p>

      <h1 id="hero-title">
        Sitios web que convierten <span>ideas en resultados.</span>
      </h1>

      <p class="hero-description">
        Diseño y desarrollo experiencias digitales rápidas, estratégicas y pensadas para ayudar a negocios y marcas a crecer.
      </p>

      <div class="hero-actions">
        <a class="button button--primary hero-button" href={site.primaryCtaUrl}>
          {site.primaryCtaLabel}
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path d="M4 10h12m-5-5 5 5-5 5" />
          </svg>
        </a>
        <a class="button button--secondary hero-button" href="/proyectos">Ver proyectos</a>
      </div>

      <ul class="hero-services" aria-label="Especialidades">
        <li>Diseño Web</li>
        <li>Desarrollo</li>
        <li>Ecommerce</li>
        <li>SEO</li>
      </ul>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="visual-orbit visual-orbit--large"></div>
      <div class="visual-orbit visual-orbit--small"></div>

      <div class="browser-frame">
        <div class="browser-topbar">
          <div class="browser-dots">
            <span></span><span></span><span></span>
          </div>
          <div class="browser-address">
            <span class="address-lock"></span>
            jokawebdesigner.com
          </div>
          <span class="browser-more">•••</span>
        </div>

        <div class="browser-page">
          <div class="mock-nav">
            <div class="mock-logo"><span>J</span> Joka</div>
            <div class="mock-links"><i></i><i></i><i></i></div>
            <div class="mock-button"></div>
          </div>

          <div class="mock-hero">
            <div class="mock-copy">
              <span class="mock-kicker"></span>
              <span class="mock-title"></span>
              <span class="mock-title mock-title--short"></span>
              <span class="mock-text"></span>
              <span class="mock-text mock-text--short"></span>
              <div class="mock-actions"><i></i><i></i></div>
            </div>
            <div class="mock-art">
              <span class="mock-art-grid"></span>
              <span class="mock-art-disc"></span>
              <span class="mock-art-panel"></span>
            </div>
          </div>

          <div class="mock-stats">
            <div><strong>98%</strong><span>Rendimiento</span></div>
            <div><strong>2.1s</strong><span>Velocidad</span></div>
            <div><strong>+42%</strong><span>Conversión</span></div>
          </div>
        </div>
      </div>

      <div class="floating-card floating-card--performance">
        <div class="card-icon">
          <svg viewBox="0 0 24 24">
            <path d="M12 3v9l6 3" />
            <circle cx="12" cy="12" r="9" />
          </svg>
        </div>
        <div>
          <span>Performance</span>
          <strong>Excelente</strong>
        </div>
        <span class="status-dot"></span>
      </div>

      <div class="floating-card floating-card--growth">
        <div class="growth-label"><span>Crecimiento</span><strong>+42%</strong></div>
        <div class="growth-bars"><i></i><i></i><i></i><i></i><i></i><i></i></div>
      </div>

      <div class="floating-chip">
        <span></span>
        Proyecto publicado
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-block: clamp(4.5rem, 7vw, 6rem) var(--space-12);
    isolation: isolate;
  }

  .hero::before {
    position: absolute;
    z-index: -2;
    inset: 0;
    background-image: radial-gradient(circle, rgb(156 78 255 / 0.12) 1px, transparent 1px);
    background-position: calc(100% - 2.5rem) 2.5rem;
    background-size: 1.75rem 1.75rem;
    content: "";
    mask-image: linear-gradient(to left, black, transparent 60%);
    opacity: 0.55;
  }

  .hero-glow {
    position: absolute;
    z-index: -1;
    border-radius: 50%;
    filter: blur(0.25rem);
    pointer-events: none;
  }

  .hero-glow--one {
    top: -16rem;
    right: -10rem;
    width: 42rem;
    height: 42rem;
    background: radial-gradient(circle, rgb(156 78 255 / 0.14), transparent 68%);
  }

  .hero-glow--two {
    bottom: -15rem;
    left: 28%;
    width: 34rem;
    height: 34rem;
    background: radial-gradient(circle, rgb(185 128 255 / 0.1), transparent 70%);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.94fr) minmax(31rem, 1.06fr);
    align-items: center;
    gap: clamp(3rem, 6vw, 6.5rem);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 42rem;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: var(--space-6);
    padding: 0.5rem 0.85rem;
    border: 1px solid rgb(156 78 255 / 0.17);
    border-radius: var(--radius-pill);
    background: rgb(251 248 255 / 0.88);
    color: #6d3cad;
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.11em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .badge-dot {
    width: 0.45rem;
    height: 0.45rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--color-primary);
    box-shadow: 0 0 0 0.25rem rgb(156 78 255 / 0.12);
  }

  h1 {
    max-width: 11ch;
    font-size: var(--font-size-heading-lg);
    letter-spacing: -0.065em;
    line-height: var(--line-height-tight);
  }

  h1 span {
    background: linear-gradient(120deg, var(--color-primary-dark), var(--color-primary-light));
    background-clip: text;
    color: transparent;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-description {
    max-width: 37rem;
    margin-top: var(--space-6);
    color: var(--color-text);
    font-size: clamp(1.05rem, 1.4vw, 1.18rem);
    line-height: 1.75;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .hero-button {
    min-height: 3.5rem;
    padding-inline: 1.65rem;
  }

  .hero-button svg {
    width: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.75;
  }

  .hero-services {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem 1.55rem;
    margin-top: var(--space-10);
    color: var(--color-muted);
    font-size: var(--font-size-xs);
    font-weight: 650;
    letter-spacing: 0.04em;
    list-style: none;
    text-transform: uppercase;
  }

  .hero-services li {
    position: relative;
  }

  .hero-services li:not(:last-child)::after {
    position: absolute;
    top: 50%;
    right: -0.9rem;
    width: 0.25rem;
    height: 0.25rem;
    border-radius: 50%;
    background: rgb(156 78 255 / 0.45);
    content: "";
    transform: translateY(-50%);
  }

  .hero-visual {
    position: relative;
    z-index: 1;
    min-width: 0;
    padding: 3.25rem 1.2rem 3.5rem 2rem;
  }

  .hero-visual::before {
    position: absolute;
    z-index: -2;
    inset: 4% 1% 3% 3%;
    border-radius: 44% 56% 52% 48% / 44% 44% 56% 56%;
    background: linear-gradient(145deg, #f8f2ff, #fdfbff 60%, #f2e7ff);
    content: "";
    transform: rotate(-5deg);
  }

  .visual-orbit {
    position: absolute;
    z-index: -1;
    border: 1px solid rgb(156 78 255 / 0.14);
    border-radius: 50%;
  }

  .visual-orbit--large {
    inset: 0 2% 0 2%;
    transform: rotate(16deg);
  }

  .visual-orbit--small {
    inset: 12% 14% 8% 8%;
    transform: rotate(-18deg);
  }

  .browser-frame {
    overflow: hidden;
    border: 1px solid rgb(42 40 48 / 0.1);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: 0 2.5rem 5rem rgb(52 30 75 / 0.15), 0 0 0 0.5rem rgb(255 255 255 / 0.55);
    transform: perspective(75rem) rotateY(-5deg) rotateX(1deg);
  }

  .browser-topbar {
    display: grid;
    height: 3.2rem;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding-inline: 1rem;
    border-bottom: 1px solid #ece8f0;
    background: #fbfafc;
  }

  .browser-dots {
    display: flex;
    gap: 0.32rem;
  }

  .browser-dots span {
    width: 0.48rem;
    height: 0.48rem;
    border-radius: 50%;
    background: #ddd7e4;
  }

  .browser-dots span:first-child {
    background: #d9c1f9;
  }

  .browser-address {
    display: flex;
    width: 12.5rem;
    height: 1.65rem;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    border: 1px solid #ece8f0;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: #9993a1;
    font-size: 0.55rem;
  }

  .address-lock {
    width: 0.35rem;
    height: 0.4rem;
    border-radius: 0.08rem;
    background: #c8c1ce;
  }

  .browser-more {
    justify-self: end;
    color: #b3adba;
    font-size: 0.65rem;
    letter-spacing: 0.12em;
  }

  .browser-page {
    padding: 1.15rem 1.25rem 1.4rem;
  }

  .mock-nav {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 1rem;
  }

  .mock-logo {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: #403c46;
    font-size: 0.56rem;
    font-weight: 800;
  }

  .mock-logo span {
    display: grid;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 0.35rem;
    background: var(--color-primary);
    color: white;
    place-items: center;
  }

  .mock-links {
    display: flex;
    gap: 0.7rem;
  }

  .mock-links i {
    width: 1.55rem;
    height: 0.18rem;
    border-radius: var(--radius-pill);
    background: #ddd8e2;
  }

  .mock-button {
    width: 3.5rem;
    height: 1.25rem;
    border-radius: var(--radius-pill);
    background: var(--color-primary);
  }

  .mock-hero {
    display: grid;
    min-height: 15rem;
    grid-template-columns: 1fr 0.9fr;
    align-items: center;
    gap: 1.5rem;
    margin-top: 1.1rem;
    padding: 1.5rem;
    border-radius: 1rem;
    background: linear-gradient(135deg, #faf7fd, #f5edff);
  }

  .mock-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .mock-kicker,
  .mock-title,
  .mock-text {
    display: block;
    border-radius: var(--radius-pill);
  }

  .mock-kicker {
    width: 3.8rem;
    height: 0.3rem;
    margin-bottom: 0.9rem;
    background: #c797ff;
  }

  .mock-title {
    width: 100%;
    height: 0.75rem;
    margin-bottom: 0.38rem;
    background: #37323d;
  }

  .mock-title--short {
    width: 70%;
    background: var(--color-primary);
  }

  .mock-text {
    width: 92%;
    height: 0.27rem;
    margin-top: 0.75rem;
    background: #c9c3ce;
  }

  .mock-text--short {
    width: 68%;
    margin-top: 0.3rem;
  }

  .mock-actions {
    display: flex;
    gap: 0.4rem;
    margin-top: 1rem;
  }

  .mock-actions i {
    width: 3.2rem;
    height: 1rem;
    border-radius: var(--radius-pill);
    background: var(--color-primary);
  }

  .mock-actions i:last-child {
    border: 1px solid #d8d2de;
    background: white;
  }

  .mock-art {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid rgb(156 78 255 / 0.13);
    border-radius: 1.25rem;
    background: linear-gradient(145deg, #301a49, #8d42e8 62%, #c997ff);
    box-shadow: inset 0 0 0 0.45rem rgb(255 255 255 / 0.08);
  }

  .mock-art-grid {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgb(255 255 255 / 0.09) 1px, transparent 1px), linear-gradient(90deg, rgb(255 255 255 / 0.09) 1px, transparent 1px);
    background-size: 1rem 1rem;
    mask-image: linear-gradient(135deg, black, transparent 75%);
  }

  .mock-art-disc {
    position: absolute;
    width: 58%;
    aspect-ratio: 1;
    top: 16%;
    left: 21%;
    border: 1px solid rgb(255 255 255 / 0.45);
    border-radius: 50%;
    background: linear-gradient(145deg, rgb(255 255 255 / 0.48), rgb(255 255 255 / 0.04));
    box-shadow: 0 1rem 2rem rgb(25 9 41 / 0.22);
  }

  .mock-art-panel {
    position: absolute;
    right: 12%;
    bottom: 11%;
    width: 50%;
    height: 27%;
    border: 1px solid rgb(255 255 255 / 0.36);
    border-radius: 0.6rem;
    background: rgb(255 255 255 / 0.18);
    backdrop-filter: blur(0.5rem);
  }

  .mock-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.65rem;
    margin-top: 0.75rem;
  }

  .mock-stats div {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: 0.65rem;
    border: 1px solid #ede8f1;
    border-radius: 0.7rem;
    background: #fff;
  }

  .mock-stats strong {
    color: #413c48;
    font-size: 0.68rem;
  }

  .mock-stats span {
    overflow: hidden;
    color: #9a94a1;
    font-size: 0.45rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .floating-card,
  .floating-chip {
    position: absolute;
    display: flex;
    border: 1px solid rgb(42 40 48 / 0.09);
    background: rgb(255 255 255 / 0.9);
    box-shadow: var(--shadow-md);
    backdrop-filter: blur(0.75rem);
  }

  .floating-card--performance {
    top: 0.5rem;
    right: -1rem;
    align-items: center;
    gap: 0.65rem;
    padding: 0.7rem 0.8rem;
    border-radius: 0.9rem;
  }

  .card-icon {
    display: grid;
    width: 2rem;
    height: 2rem;
    border-radius: 0.65rem;
    background: var(--color-primary-soft);
    color: var(--color-primary-dark);
    place-items: center;
  }

  .card-icon svg {
    width: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.75;
  }

  .floating-card--performance > div:nth-child(2) {
    display: flex;
    flex-direction: column;
  }

  .floating-card--performance span,
  .growth-label span {
    color: var(--color-muted);
    font-size: 0.55rem;
    line-height: 1.35;
  }

  .floating-card--performance strong,
  .growth-label strong {
    color: var(--color-ink);
    font-size: 0.7rem;
    line-height: 1.35;
  }

  .status-dot {
    width: 0.45rem;
    height: 0.45rem;
    margin-left: 0.35rem;
    border-radius: 50%;
    background: #52c98a;
    box-shadow: 0 0 0 0.23rem rgb(82 201 138 / 0.14);
  }

  .floating-card--growth {
    bottom: 0.5rem;
    left: -0.5rem;
    width: 10rem;
    flex-direction: column;
    gap: 0.65rem;
    padding: 0.85rem;
    border-radius: 0.9rem;
  }

  .growth-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .growth-label strong {
    color: var(--color-primary-dark);
  }

  .growth-bars {
    display: flex;
    height: 2.1rem;
    align-items: flex-end;
    gap: 0.25rem;
  }

  .growth-bars i {
    width: 100%;
    height: 35%;
    border-radius: 0.15rem 0.15rem 0 0;
    background: #e6d2ff;
  }

  .growth-bars i:nth-child(2) { height: 47%; }
  .growth-bars i:nth-child(3) { height: 42%; }
  .growth-bars i:nth-child(4) { height: 64%; }
  .growth-bars i:nth-child(5) { height: 76%; }
  .growth-bars i:nth-child(6) { height: 100%; background: var(--color-primary); }

  .floating-chip {
    right: -0.75rem;
    bottom: 4.25rem;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.7rem;
    border-radius: var(--radius-pill);
    color: #635e69;
    font-size: 0.55rem;
    font-weight: 650;
  }

  .floating-chip span {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: #52c98a;
  }

  @media (max-width: 68.74rem) {
    .hero {
      padding-block: 4.5rem var(--space-8);
    }

    .hero-grid {
      grid-template-columns: minmax(0, 0.88fr) minmax(26rem, 1.12fr);
      gap: 2.5rem;
    }

    h1 {
      font-size: clamp(3rem, 6vw, 4.25rem);
    }

    .hero-visual {
      padding-inline: 1rem;
    }
  }

  @media (max-width: 52rem) {
    .hero {
      padding-top: 4.5rem;
    }

    .hero::before {
      mask-image: linear-gradient(to bottom, transparent 25%, black);
    }

    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 3.75rem;
    }

    .hero-content {
      max-width: 42rem;
    }

    h1 {
      max-width: 12ch;
      font-size: clamp(3.35rem, 9vw, 4.6rem);
    }

    .hero-visual {
      width: min(100%, 38rem);
      margin-inline: auto;
    }
  }

  @media (max-width: 31.25rem) {
    .hero {
      padding-block: 3.5rem 1.75rem;
    }

    .hero-grid {
      gap: 3rem;
    }

    .hero-badge {
      max-width: 100%;
      align-items: flex-start;
      font-size: 0.61rem;
      letter-spacing: 0.08em;
    }

    .badge-dot {
      margin-top: 0.2rem;
    }

    h1 {
      max-width: 100%;
      font-size: clamp(2.75rem, 13.25vw, 3.35rem);
      letter-spacing: -0.06em;
    }

    .hero-description {
      margin-top: var(--space-5);
      font-size: 1rem;
      line-height: 1.65;
    }

    .hero-actions {
      flex-direction: column;
      margin-top: var(--space-6);
    }

    .hero-button {
      width: 100%;
    }

    .hero-services {
      gap: 0.55rem 1.3rem;
      margin-top: var(--space-8);
      font-size: 0.68rem;
    }

    .hero-services li:not(:last-child)::after {
      right: -0.75rem;
    }

    .hero-visual {
      width: calc(100% + 0.25rem);
      padding: 2.4rem 0 2.7rem;
    }

    .browser-frame {
      border-radius: 1.15rem;
      transform: none;
    }

    .browser-topbar {
      height: 2.5rem;
      padding-inline: 0.7rem;
    }

    .browser-address {
      width: 8.5rem;
      font-size: 0.45rem;
    }

    .browser-page {
      padding: 0.8rem;
    }

    .mock-links {
      display: none;
    }

    .mock-hero {
      min-height: 10.5rem;
      gap: 0.75rem;
      padding: 0.85rem;
    }

    .mock-stats {
      gap: 0.35rem;
    }

    .mock-stats div {
      padding: 0.45rem;
    }

    .floating-card--performance {
      top: 0;
      right: -0.35rem;
      transform: scale(0.86);
      transform-origin: right center;
    }

    .floating-card--growth {
      bottom: 0;
      left: -0.35rem;
      transform: scale(0.82);
      transform-origin: left center;
    }

    .floating-chip {
      right: -0.35rem;
      bottom: 2.3rem;
      transform: scale(0.86);
      transform-origin: right center;
    }
  }
</style>
