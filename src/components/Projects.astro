---
import { getCollection } from "astro:content";

const projects = (await getCollection("projects", ({ data }) => data.active))
  .map(({ data }) => data)
  .sort((a, b) => a.order - b.order);

type ProjectVisualVariant = "repromedic" | "doctor" | "portfolio";

const projectVisualVariants: Record<string, ProjectVisualVariant> = {
  repromedic: "repromedic",
  "edgar-llanos": "doctor",
  jokawebdesigner: "portfolio",
};

const fallbackVisualVariants: ProjectVisualVariant[] = ["repromedic", "doctor", "portfolio"];
---

<section class="projects-section" id="proyectos" aria-labelledby="projects-title">
  <div class="projects-glow"></div>
  <div class="container">
    <header class="section-heading">
      <div>
        <p class="section-eyebrow"><span></span> Proyectos</p>
        <h2 id="projects-title">Proyectos que convierten ideas en experiencias digitales.</h2>
      </div>
      <p class="section-description">
        Estrategia, diseño y tecnología trabajando juntos para construir sitios que comunican, conectan y generan resultados.
      </p>
    </header>

    <div class="projects-grid">
      {
        projects.map((project, index) => {
          const visualVariant = projectVisualVariants[project.slug] ?? fallbackVisualVariants[index % fallbackVisualVariants.length];

          return (
            <article
              class:list={[
                "project-card",
                {
                  "project-card--featured": project.featured,
                  "project-card--portrait": visualVariant === "doctor",
                  "project-card--wide": visualVariant === "portfolio",
                },
              ]}
            >
              {project.image && (
                <div class:list={["project-visual", `project-visual--${visualVariant}`]}>
                  <img
                    class="project-image"
                    src={project.image}
                    alt={project.imageAlt}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              )}

              {!project.image && visualVariant === "repromedic" && (
              <div class="project-visual project-visual--repromedic" aria-hidden="true">
                <div class="project-browser">
                  <div class="project-browser-bar"><i></i><i></i><i></i><span>repromedic.pe</span></div>
                  <div class="medical-page">
                    <div class="medical-nav"><b>repromedic</b><span></span><span></span><span></span><i></i></div>
                    <div class="medical-content">
                      <div class="medical-copy"><em></em><strong></strong><strong></strong><span></span><span></span><i class="mock-cta"></i></div>
                      <div class="medical-art"><i></i><span>+</span></div>
                    </div>
                    <div class="medical-stats"><span></span><span></span><span></span></div>
                  </div>
                </div>
                <div class="visual-tag visual-tag--one"><span>+38%</span> solicitudes</div>
              </div>
              )}

              {!project.image && visualVariant === "doctor" && (
              <div class="project-visual project-visual--doctor" aria-hidden="true">
                <div class="doctor-window">
                  <div class="doctor-nav"><b>EL</b><span></span><span></span><i></i></div>
                  <div class="doctor-hero">
                    <div class="doctor-copy"><em></em><strong></strong><strong></strong><span></span><i class="mock-cta"></i></div>
                    <div class="doctor-portrait"><i></i></div>
                  </div>
                  <div class="doctor-footer"><span></span><span></span><span></span></div>
                </div>
                <div class="visual-tag visual-tag--two"><i></i> Citas online</div>
              </div>
              )}

              {!project.image && visualVariant === "portfolio" && (
              <div class="project-visual project-visual--portfolio" aria-hidden="true">
                <div class="portfolio-window">
                  <div class="portfolio-sidebar"><b>J.</b><i></i><i></i><i></i><span></span></div>
                  <div class="portfolio-main">
                    <div class="portfolio-top"><span></span><span></span><i></i></div>
                    <div class="portfolio-headline"><em></em><strong></strong><strong></strong><span></span></div>
                    <div class="portfolio-cards"><i></i><i></i><i></i></div>
                  </div>
                </div>
                <div class="visual-tag visual-tag--three"><span></span> Diseño &amp; código</div>
              </div>
              )}

              <div class="project-info">
                <div>
                  <p class="project-category">{project.category}</p>
                  <h3>{project.title}</h3>
                </div>
                <p>{project.description}</p>
                <a href={project.projectUrl} aria-label={`Ver proyecto ${project.title}`}>
                  Ver proyecto
                  <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5" /></svg>
                </a>
              </div>
            </article>
          );
        })
      }
    </div>

    <div class="projects-footer">
      <p>Una selección de proyectos creados con intención y atención al detalle.</p>
      <a class="button projects-button" href="/proyectos">
        Ver todos los proyectos
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5" /></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .projects-section {
    position: relative;
    padding-block: 3.75rem;
    overflow: hidden;
    background: var(--color-ink);
    color: var(--color-surface);
    isolation: isolate;
  }

  .projects-section::before {
    position: absolute;
    z-index: -2;
    inset: 0;
    background-image: radial-gradient(circle, rgb(255 255 255 / 0.08) 1px, transparent 1px);
    background-position: 1rem 1rem;
    background-size: 2rem 2rem;
    content: "";
    mask-image: linear-gradient(to bottom, black, transparent 42%);
    opacity: 0.28;
  }

  .projects-glow {
    position: absolute;
    z-index: -1;
    top: -25rem;
    left: 45%;
    width: 50rem;
    height: 50rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(156 78 255 / 0.2), transparent 68%);
    pointer-events: none;
  }

  .section-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(19rem, 0.65fr);
    align-items: end;
    gap: clamp(2rem, 7vw, 7rem);
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .section-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: var(--space-4);
    color: var(--color-primary-light);
    font-size: var(--font-size-xs);
    font-weight: 750;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .section-eyebrow span {
    width: 1.8rem;
    height: 0.125rem;
    border-radius: var(--radius-pill);
    background: var(--color-primary);
  }

  h2 {
    max-width: 18ch;
    color: var(--color-surface);
    font-size: var(--font-size-heading-sm);
    letter-spacing: -0.045em;
  }

  .section-description {
    max-width: 32rem;
    color: #bcb6c5;
    font-size: var(--font-size-lg);
    line-height: 1.75;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-6);
  }

  .project-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.1);
    border-radius: var(--radius-lg);
    background: #34313a;
    box-shadow: 0 1.5rem 4rem rgb(0 0 0 / 0.14);
  }

  .project-card--featured {
    grid-column: span 7;
  }

  .project-card--portrait {
    grid-column: span 5;
  }

  .project-card--wide {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: minmax(0, 1.25fr) minmax(23rem, 0.75fr);
  }

  .project-visual {
    position: relative;
    display: grid;
    min-height: 26rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    overflow: hidden;
    place-items: end center;
  }

  .project-visual::before {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgb(255 255 255 / 0.07) 1px, transparent 1px), linear-gradient(90deg, rgb(255 255 255 / 0.07) 1px, transparent 1px);
    background-size: 1.75rem 1.75rem;
    content: "";
    mask-image: linear-gradient(to bottom right, black, transparent 75%);
  }

  .project-visual--repromedic {
    background: linear-gradient(145deg, #dacaff, #9b73ee 58%, #6342b5);
  }

  .project-visual--doctor {
    background: linear-gradient(145deg, #d3f0ec, #7cc0b9 62%, #347d79);
  }

  .project-visual--portfolio {
    min-height: 24rem;
    background: linear-gradient(135deg, #cba2ff, #8434e9 55%, #4b176f);
  }

  .project-image {
    position: absolute;
    z-index: 1;
    width: 100%;
    height: 100%;
    inset: 0;
    max-width: none;
    object-fit: cover;
  }

  .project-browser,
  .doctor-window,
  .portfolio-window {
    position: relative;
    z-index: 1;
    width: 94%;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.5);
    border-radius: 1rem 1rem 0 0;
    background: white;
    box-shadow: 0 1.75rem 3.5rem rgb(40 22 62 / 0.25);
    transform: translateY(2.5rem) rotate(-1deg);
    transition: transform 400ms ease;
  }

  .project-card:hover .project-browser,
  .project-card:hover .doctor-window,
  .project-card:hover .portfolio-window {
    transform: translateY(1.8rem) rotate(0deg);
  }

  .project-browser-bar {
    display: flex;
    height: 2.2rem;
    align-items: center;
    gap: 0.3rem;
    padding-inline: 0.75rem;
    border-bottom: 1px solid #eeeaf1;
    background: #faf9fb;
  }

  .project-browser-bar i {
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 50%;
    background: #d8d3dc;
  }

  .project-browser-bar span {
    margin-inline: auto;
    padding-right: 2rem;
    color: #aaa4af;
    font-size: 0.45rem;
  }

  .medical-page {
    padding: 1rem;
  }

  .medical-nav,
  .doctor-nav {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .medical-nav b {
    margin-right: auto;
    color: #6940b0;
    font-size: 0.58rem;
  }

  .medical-nav span,
  .doctor-nav span {
    width: 1.6rem;
    height: 0.16rem;
    border-radius: var(--radius-pill);
    background: #ded9e3;
  }

  .medical-nav i,
  .doctor-nav i {
    width: 2.8rem;
    height: 1rem;
    border-radius: var(--radius-pill);
    background: #8c52e3;
  }

  .medical-content {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 1rem;
    margin-top: 1rem;
    padding: 1.25rem;
    border-radius: 0.8rem;
    background: #f4effc;
  }

  .medical-copy,
  .doctor-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
  }

  .medical-copy em,
  .doctor-copy em,
  .portfolio-headline em {
    width: 30%;
    height: 0.24rem;
    margin-bottom: 0.65rem;
    border-radius: var(--radius-pill);
    background: #9c61e9;
  }

  .medical-copy strong,
  .doctor-copy strong,
  .portfolio-headline strong {
    width: 90%;
    height: 0.55rem;
    margin-bottom: 0.3rem;
    border-radius: var(--radius-pill);
    background: #38323f;
  }

  .medical-copy strong:nth-child(3),
  .doctor-copy strong:nth-child(3),
  .portfolio-headline strong:nth-child(3) {
    width: 66%;
  }

  .medical-copy span,
  .doctor-copy span,
  .portfolio-headline span {
    width: 78%;
    height: 0.2rem;
    margin-top: 0.45rem;
    border-radius: var(--radius-pill);
    background: #c9c3ce;
  }

  .mock-cta {
    width: 3.5rem;
    height: 1.05rem;
    margin-top: 0.85rem;
    border-radius: var(--radius-pill);
    background: #8c52e3;
  }

  .medical-art {
    position: relative;
    min-height: 9rem;
    overflow: hidden;
    border-radius: 0.8rem;
    background: linear-gradient(145deg, #5f35a6, #b68af3);
  }

  .medical-art i {
    position: absolute;
    width: 70%;
    aspect-ratio: 1;
    right: -12%;
    bottom: -20%;
    border: 1px solid rgb(255 255 255 / 0.42);
    border-radius: 50%;
    background: rgb(255 255 255 / 0.12);
  }

  .medical-art span {
    position: absolute;
    top: 22%;
    left: 25%;
    color: rgb(255 255 255 / 0.8);
    font-size: 2rem;
    font-style: normal;
    font-weight: 200;
  }

  .medical-stats,
  .doctor-footer {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .medical-stats span,
  .doctor-footer span {
    height: 2.25rem;
    border: 1px solid #ede9f0;
    border-radius: 0.45rem;
    background: #fcfbfd;
  }

  .doctor-window {
    width: 83%;
    border-radius: 1rem 1rem 0 0;
    transform: translateY(2.5rem) rotate(1deg);
  }

  .doctor-nav {
    padding: 0.85rem;
  }

  .doctor-nav b {
    display: grid;
    width: 1.4rem;
    height: 1.4rem;
    margin-right: auto;
    border-radius: 50%;
    background: #327b76;
    color: white;
    font-size: 0.48rem;
    place-items: center;
  }

  .doctor-nav i {
    width: 2.4rem;
    background: #327b76;
  }

  .doctor-hero {
    display: grid;
    grid-template-columns: 1fr 0.85fr;
    gap: 0.75rem;
    padding: 1.1rem 1rem 0;
    background: #edf7f5;
  }

  .doctor-copy em,
  .doctor-copy .mock-cta {
    background: #3b928b;
  }

  .doctor-portrait {
    position: relative;
    min-height: 11rem;
    overflow: hidden;
    border-radius: 5rem 5rem 0.5rem 0.5rem;
    background: linear-gradient(155deg, #7ec4bd, #286f6a);
  }

  .doctor-portrait::before {
    position: absolute;
    width: 45%;
    aspect-ratio: 1;
    top: 14%;
    left: 28%;
    border-radius: 50%;
    background: #d8ece8;
    content: "";
  }

  .doctor-portrait i {
    position: absolute;
    width: 74%;
    height: 56%;
    right: 13%;
    bottom: -5%;
    border-radius: 50% 50% 0 0;
    background: #f8fbfa;
  }

  .doctor-footer {
    margin: 0;
    padding: 0.65rem;
  }

  .visual-tag {
    position: absolute;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 0.7rem;
    border: 1px solid rgb(255 255 255 / 0.45);
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.91);
    box-shadow: var(--shadow-md);
    color: #6b6571;
    font-size: 0.58rem;
    font-weight: 650;
    backdrop-filter: blur(0.5rem);
  }

  .visual-tag--one {
    top: 12%;
    right: 2%;
  }

  .visual-tag--one span {
    color: var(--color-primary-dark);
    font-weight: 800;
  }

  .visual-tag--two {
    bottom: 12%;
    left: 3%;
  }

  .visual-tag--two i,
  .visual-tag--three span {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: #54bd89;
  }

  .portfolio-window {
    display: grid;
    width: 90%;
    grid-template-columns: 3rem 1fr;
    border-radius: 1rem;
    transform: translateY(1rem) rotate(-1deg);
  }

  .portfolio-sidebar {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    padding-block: 0.8rem;
    background: #2f1b40;
  }

  .portfolio-sidebar b {
    display: grid;
    width: 1.5rem;
    height: 1.5rem;
    margin-bottom: 0.4rem;
    border-radius: 0.45rem;
    background: #a152ff;
    color: white;
    font-size: 0.55rem;
    place-items: center;
  }

  .portfolio-sidebar i {
    width: 0.85rem;
    height: 0.18rem;
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.3);
  }

  .portfolio-sidebar span {
    width: 1.25rem;
    height: 1.25rem;
    margin-top: auto;
    border: 1px solid rgb(255 255 255 / 0.25);
    border-radius: 50%;
  }

  .portfolio-main {
    padding: 1rem 1.2rem 1.25rem;
    background: #faf8fc;
  }

  .portfolio-top {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .portfolio-top span {
    width: 2.1rem;
    height: 0.2rem;
    border-radius: var(--radius-pill);
    background: #d3ccd8;
  }

  .portfolio-top i {
    width: 3rem;
    height: 1.15rem;
    margin-left: auto;
    border-radius: var(--radius-pill);
    background: #9c4eff;
  }

  .portfolio-headline {
    display: flex;
    width: 45%;
    flex-direction: column;
    margin-top: 2rem;
  }

  .portfolio-headline em {
    background: #9c4eff;
  }

  .portfolio-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.6rem;
    margin-top: 1.5rem;
  }

  .portfolio-cards i {
    height: 5rem;
    border-radius: 0.55rem;
    background: linear-gradient(145deg, #e7d2ff, #9560d8);
  }

  .portfolio-cards i:nth-child(2) {
    background: linear-gradient(145deg, #cee9e5, #57a69e);
  }

  .portfolio-cards i:nth-child(3) {
    background: linear-gradient(145deg, #e8e3eb, #7b7183);
  }

  .visual-tag--three {
    top: 16%;
    right: 3%;
  }

  .visual-tag--three span {
    background: var(--color-primary);
  }

  .project-info {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(12rem, 0.8fr) auto;
    align-items: end;
    gap: var(--space-8);
    padding: clamp(1.75rem, 3vw, 2.5rem);
  }

  .project-card--wide .project-info {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-5);
  }

  .project-card--wide .project-info > a {
    margin-top: auto;
  }

  .project-card:not(.project-card--wide) .project-info {
    grid-template-columns: 1fr auto;
  }

  .project-card:not(.project-card--wide) .project-info > p {
    grid-column: 1 / -1;
    grid-row: 2;
  }

  .project-card:not(.project-card--wide) .project-info > a {
    grid-column: 2;
    grid-row: 1;
  }

  .project-category {
    margin-bottom: var(--space-2);
    color: var(--color-primary-light);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  h3 {
    color: var(--color-surface);
    font-size: clamp(1.35rem, 2.2vw, 1.75rem);
    letter-spacing: -0.035em;
  }

  .project-info > p {
    max-width: 37rem;
    color: #bcb6c5;
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .project-info > a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: white;
    font-size: var(--font-size-sm);
    font-weight: 700;
    white-space: nowrap;
    transition: color var(--transition-fast), gap var(--transition-fast);
  }

  .project-info > a:hover {
    gap: 0.75rem;
    color: var(--color-primary-light);
  }

  .project-info > a svg,
  .projects-button svg {
    width: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.75;
  }

  .projects-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    margin-top: var(--space-10);
  }

  .projects-footer p {
    color: #9e98a6;
    font-size: var(--font-size-sm);
  }

  .projects-button {
    border-color: rgb(255 255 255 / 0.18);
    background: white;
    color: var(--color-ink);
  }

  .projects-button:hover {
    background: var(--color-primary-soft);
    color: var(--color-primary-dark);
  }

  @media (max-width: 64rem) {
    .projects-section {
      padding-block: var(--space-12);
    }

    .section-heading {
      grid-template-columns: minmax(0, 1fr) minmax(17rem, 0.65fr);
      gap: 3rem;
    }

    .project-card--featured,
    .project-card--portrait {
      grid-column: span 6;
    }

    .project-card--wide {
      grid-template-columns: minmax(0, 1.1fr) minmax(20rem, 0.9fr);
    }

    .project-info,
    .project-card--wide .project-info {
      grid-template-columns: 1fr auto;
    }

    .project-card--wide .project-info > p {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    .project-card--wide .project-info > a {
      grid-column: 2;
      grid-row: 1;
    }
  }

  @media (max-width: 47.99rem) {
    .section-heading {
      grid-template-columns: 1fr;
      gap: var(--space-5);
      margin-bottom: var(--space-12);
    }

    .section-description {
      font-size: 1rem;
    }

    .projects-grid {
      grid-template-columns: 1fr;
    }

    .project-card--featured,
    .project-card--portrait,
    .project-card--wide {
      display: flex;
      grid-column: auto;
    }

    .project-visual,
    .project-visual--portfolio {
      min-height: clamp(20rem, 72vw, 27rem);
    }

    .portfolio-window {
      width: 96%;
    }
  }

  @media (max-width: 37.5rem) {
    .projects-section {
      padding-block: var(--space-8);
    }

    .project-visual {
      padding: var(--space-4);
    }

    .project-info,
    .project-card:not(.project-card--wide) .project-info,
    .project-card--wide .project-info {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-5);
      padding: var(--space-6);
    }

    .project-info > p {
      order: 2;
    }

    .project-info > a {
      order: 3;
    }

