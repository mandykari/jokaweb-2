---
const testimonials = [
  "Una experiencia de trabajo clara, cercana y orientada a objetivos.",
  "Comunicación constante y un proceso sencillo de principio a fin.",
  "Una solución digital construida con intención y atención a cada detalle.",
];
---

<section class="testimonials-section" aria-labelledby="testimonials-title">
  <div class="container">
    <header class="testimonials-heading">
      <p class="section-eyebrow"><span></span> Experiencias</p>
      <h2 id="testimonials-title">Relaciones construidas proyecto a proyecto.</h2>
    </header>

    <div class="testimonials-grid">
      {
        testimonials.map((testimonial, index) => (
          <figure class:list={["testimonial-card", { "testimonial-card--lead": index === 0 }]}>
            <div class="testimonial-top">
              <span class="sample-label">Contenido de ejemplo</span>
              <span class="quote-mark" aria-hidden="true">“</span>
            </div>
            <blockquote>
              <p>{testimonial}</p>
            </blockquote>
            <figcaption>
              <span class="avatar-placeholder" aria-hidden="true"><i></i></span>
              <span>
                <strong>Testimonio próximamente</strong>
                <small>Contenido temporal por reemplazar</small>
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .testimonials-section {
    position: relative;
    padding-block: 3.75rem;
    overflow: hidden;
    background: linear-gradient(145deg, #faf7fd, var(--color-primary-faint));
  }

  .testimonials-section::after {
    position: absolute;
    width: 30rem;
    height: 30rem;
    right: -18rem;
    bottom: -20rem;
    border: 1px solid rgb(156 78 255 / 0.13);
    border-radius: 50%;
    content: "";
  }

  .testimonials-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-8);
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .section-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: var(--space-4);
    color: var(--color-primary-dark);
    font-size: var(--font-size-xs);
    font-weight: 750;
    letter-spacing: 0.14em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .section-eyebrow span {
    width: 1.8rem;
    height: 0.125rem;
    border-radius: var(--radius-pill);
    background: var(--color-primary);
  }

  h2 {
    max-width: 20ch;
    font-size: var(--font-size-heading-sm);
    letter-spacing: -0.045em;
  }

  .testimonials-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(19rem, 0.75fr);
    gap: var(--space-5);
  }

  .testimonial-card {
    display: flex;
    min-width: 0;
    min-height: 17rem;
    flex-direction: column;
    margin: 0;
    padding: clamp(1.75rem, 3vw, 2.5rem);
    border: 1px solid rgb(156 78 255 / 0.12);
    border-radius: var(--radius-lg);
    background: rgb(255 255 255 / 0.82);
    box-shadow: var(--shadow-sm);
  }

  .testimonial-card--lead {
    grid-row: span 2;
    min-height: 35.25rem;
    background: var(--color-surface);
  }

  .testimonial-top {
    display: flex;
    min-height: 3.5rem;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .sample-label {
    padding: 0.45rem 0.7rem;
    border: 1px solid rgb(156 78 255 / 0.16);
    border-radius: var(--radius-pill);
    background: var(--color-primary-soft);
    color: var(--color-primary-dark);
    font-size: 0.62rem;
    font-weight: 750;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .quote-mark {
    height: 2.5rem;
    color: rgb(156 78 255 / 0.2);
    font-family: Georgia, serif;
    font-size: 4rem;
    line-height: 1;
  }

  blockquote {
    display: flex;
    flex: 1;
    align-items: center;
    margin: 0;
    padding-block: var(--space-6);
  }

  blockquote p {
    max-width: 29ch;
    color: var(--color-ink);
    font-size: clamp(1.2rem, 2vw, 1.55rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.5;
  }

  .testimonial-card--lead blockquote p {
    max-width: 24ch;
    font-size: clamp(1.75rem, 3vw, 2.55rem);
    line-height: 1.35;
  }

  figcaption {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .avatar-placeholder {
    position: relative;
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    flex: 0 0 auto;
    overflow: hidden;
    border-radius: 50%;
    background: linear-gradient(145deg, #e5d2ff, #b675ff);
    place-items: center;
  }

  .avatar-placeholder::before {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.72);
    content: "";
  }

  .avatar-placeholder i {
    position: absolute;
    width: 1.6rem;
    height: 0.9rem;
    right: 0.58rem;
    bottom: 0.15rem;
    border-radius: 50% 50% 0 0;
    background: rgb(255 255 255 / 0.72);
  }

  figcaption > span:last-child {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  figcaption strong {
    color: var(--color-ink);
    font-size: 0.86rem;
    line-height: 1.4;
  }

  figcaption small {
    color: var(--color-muted);
    font-size: 0.72rem;
    line-height: 1.5;
  }

  @media (max-width: 64rem) {
    .testimonials-section {
      padding-block: var(--space-12);
    }
  }

  @media (max-width: 47.99rem) {
    .testimonials-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 0;
    }

    .testimonials-heading h2 {
      max-width: 17ch;
    }

    .testimonials-grid {
      grid-template-columns: 1fr;
    }

    .testimonial-card,
    .testimonial-card--lead {
      grid-row: auto;
      min-height: 18rem;
    }

    .testimonial-card--lead blockquote p {
      font-size: clamp(1.5rem, 6vw, 2rem);
    }
  }

  @media (max-width: 37.5rem) {
    .testimonials-section {
      padding-block: var(--space-8);
    }

    .testimonial-card,
    .testimonial-card--lead {
      min-height: 19rem;
      padding: var(--space-6);
    }
  }
</style>
